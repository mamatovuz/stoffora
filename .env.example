# ================================================================
# STAFFORA ENVIRONMENT VARIABLES
# ================================================================
# Bu fayl namuna. Uni `.env` nomi bilan nusxalang, lekin `.env` faylini
# GitHub'ga commit qilmang. Railway'da qiymatlarni Service > Variables
# bo'limiga alohida KEY=VALUE ko'rinishida kiriting.

# ----------------------------------------------------------------
# 1. APPLICATION
# ----------------------------------------------------------------

# Lokal: development
# Railway: production
NODE_ENV=development

# Brauzer ochadigan saytning to'liq URL'i. Oxirida `/` bo'lmasin.
# Lokal qiymat:
APP_URL=http://localhost:3000
# Railway misol: APP_URL=https://staffora-production.up.railway.app
# Custom domain misol: APP_URL=https://staffora.uz

# PORT'ni Railway o'zi beradi. Railway Variables ichida PORT yaratmang.
# Lokal server uchun default port 4000; zarur bo'lsa quyidagi qatorni oching.
# PORT=4000

# ----------------------------------------------------------------
# 2. SQLITE DATABASE
# ----------------------------------------------------------------

# Lokal SQLite fayli. Papka/fayl mavjud bo'lmasa avtomatik yaratiladi.
SQLITE_PATH=./data/staffora.sqlite

# Railway'da Volume mount path'ni `/data` qiling va Variables ichida:
# SQLITE_PATH=/data/staffora.sqlite
#
# Agar SQLITE_PATH yozilmasa, dastur Railway bergan
# RAILWAY_VOLUME_MOUNT_PATH qiymatidan avtomatik foydalanadi.
# RAILWAY_VOLUME_MOUNT_PATH'ni qo'lda yaratish SHART EMAS — Railway Volume
# ulanganda uni avtomatik beradi.

# ----------------------------------------------------------------
# 3. SECURITY SECRETS
# ----------------------------------------------------------------

# Har bir secret alohida, tasodifiy va kamida 32 belgidan iborat bo'lsin.
# Terminalda yangi secret yaratish:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Buyruqni 3 marta ishga tushiring va har safar chiqqan boshqa qiymatni yozing.

# Admin/HR web sessiyasini imzolash uchun:
SESSION_SECRET=CHANGE_ME_GENERATE_A_RANDOM_96_CHARACTER_HEX_VALUE

# Telegram Mini App xodim sessiyasini imzolash uchun:
JWT_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_RANDOM_96_CHARACTER_HEX_VALUE

# 60 soniyalik dinamik attendance QR tokenini imzolash uchun:
QR_SIGNING_SECRET=CHANGE_ME_GENERATE_ANOTHER_RANDOM_96_CHARACTER_HEX_VALUE

# Lokal HTTP uchun false. Railway HTTPS uchun doim true.
COOKIE_SECURE=false

# Face ID yuz mosligini qabul qilish chegarasi. Kichik qiymat qat'iyroq.
# Tavsiya: 0.50. 0.30 dan past yoki 0.80 dan yuqori qiymat avtomatik 0.50 bo'ladi.
# Production'da real xodimlar bilan nazoratli test qilmasdan oshirmang.
FACE_MATCH_THRESHOLD=0.50

# ----------------------------------------------------------------
# 4. TELEGRAM BOT + MINI APP
# ----------------------------------------------------------------

# BotFather bergan token. Misol qiymat yozilgan, haqiqiy tokenni Railway
# Variables'da saqlang. Tokenni GitHub'ga joylamang.
TELEGRAM_BOT_TOKEN=

# Bot username. `@` belgisisiz yozish tavsiya qilinadi.
TELEGRAM_BOT_USERNAME=stafforauzbot

# Telegram ichida ochiladigan HTTPS Mini App URL'i. MUHIM: faqat https://
# Bo'sh qoldirsangiz APP_URL yoki Railway domenidan avtomatik olinadi.
# http:// yoki localhost bo'lsa Telegram "Staffora'ni ochish" tugmasini ko'rsatmaydi.
# Lokal sinov uchun HTTPS tunnel kerak: npx cloudflared tunnel --url http://localhost:3000
# TELEGRAM_WEBAPP_URL=https://SIZNING-DOMENINGIZ/mini-app
# Railway misol:
# TELEGRAM_WEBAPP_URL=https://staffora-production.up.railway.app/mini-app

# Faqat lokal brauzer preview uchun true.
# Railway production'da ALBATTA false bo'lsin.
TELEGRAM_DEV_MODE=true

# TELEGRAM_DEV_MODE=true bo'lganda qaysi demo xodim ochilishi.
# Bo'sh qolsa birinchi faol xodim ochiladi.
# TELEGRAM_DEV_EMPLOYEE_ID=

# ----------------------------------------------------------------
# 5. RAILWAY PRODUCTION UCHUN TAYYOR QIYMATLAR SHAKLI
# ----------------------------------------------------------------
# Quyidagilarni aynan Railway > Service > Variables ichiga kiriting:
#
# NODE_ENV=production
# APP_URL=https://SIZNING-DOMENINGIZ.up.railway.app
# SQLITE_PATH=/data/staffora.sqlite
# SESSION_SECRET=<terminalda yaratilgan 1-secret>
# JWT_SECRET=<terminalda yaratilgan 2-secret>
# QR_SIGNING_SECRET=<terminalda yaratilgan 3-secret>
# COOKIE_SECURE=true
# FACE_MATCH_THRESHOLD=0.50
# TELEGRAM_BOT_TOKEN=<BotFather bergan token>
# TELEGRAM_BOT_USERNAME=<bot username, @ belgisiz>
# TELEGRAM_WEBAPP_URL=https://SIZNING-DOMENINGIZ.up.railway.app/mini-app
# TELEGRAM_DEV_MODE=false
# # Bo'sh qolsa birinchi faol xodim ochiladi.
# TELEGRAM_DEV_EMPLOYEE_ID=
#
# Railway avtomatik beradigan va qo'lda yaratmaslik kerak bo'lgan keylar:
# PORT
# RAILWAY_PUBLIC_DOMAIN
# RAILWAY_VOLUME_MOUNT_PATH
# RAILWAY_PROJECT_ID
# RAILWAY_SERVICE_ID

# ----------------------------------------------------------------
# 6. SUPER ADMIN (ixtiyoriy)
# ----------------------------------------------------------------
# Barcha kompaniyalarni boshqaruvchi hisob. Bazada super admin bo'lmasa,
# server ishga tushganda shu qiymatlar bilan yaratiladi.
# BOOTSTRAP_SUPER_ADMIN_EMAIL=super@sizning-domen.uz
# BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# --- Mini App (ixtiyoriy) ---
# Ishga kelganda Telegram emoji-statusi (Premium foydalanuvchilar uchun custom emoji ID)
# TELEGRAM_WORK_EMOJI_ID=
# Rahbar xaritasi: standart — OpenStreetMap plitkalari. Ko‘p foydalanuvchida o‘z xizmatingizni ulang
# (masalan MapTiler): VITE_ build vaqtida o‘qiladi, MAP_TILE_ORIGIN — CSP ruxsati uchun.
# VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=KALIT
# VITE_MAP_ATTRIBUTION=© MapTiler © OpenStreetMap
# MAP_TILE_ORIGIN=https://api.maptiler.com

# ---------------------------------------------------------------- Mobil ilova (iOS / Android)
# Push xabarnomalar Expo Push Service orqali (APNs/FCM kalitlari Expo/EAS loyihasida saqlanadi).
# Expo «Enhanced Push Security» yoqilgan bo‘lsa — kirish tokeni (serverda, ilovada emas):
# EXPO_ACCESS_TOKEN=
# Push’ni butunlay o‘chirish:
# MOBILE_PUSH=false
# Faollashtirish urinishlari limiti (IP bo‘yicha, daqiqasiga). Standart: 10
# MOBILE_ACTIVATION_RATE_LIMIT=10

# ------------------------------------------------------------ PostgreSQL (ixtiyoriy)
# Berilsa — ma’lumotlar PostgreSQL’da saqlanadi. Birinchi ishga tushishda eski SQLite fayli
# (SQLITE_PATH yoki Railway volume’dagi staffora.sqlite) bo‘lsa, undagi BARCHA ma’lumot
# avtomatik ko‘chiriladi va har bir jadval soni tekshiriladi. SQLite fayli zaxira bo‘lib qoladi.
# Railway: app servisida  DATABASE_URL = ${{Postgres.DATABASE_URL}}  (parolni bu yerga yozmang).
# DIQQAT: replikalar soni 1 bo‘lsin — server bitta yozuvchi; ikkinchi nusxa faqat kutadi.
# DATABASE_URL=postgresql://user:password@host:5432/railway
